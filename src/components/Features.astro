---
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {t.features.map((feature, idx) => (
      <div class="p-6 rounded-2xl bg-theme-card border border-theme-border/60 shadow-soft hover:shadow-soft-lg transition-all group">
        <div class="w-12 h-12 rounded-xl bg-theme-bg flex items-center justify-center mb-4 text-theme-accent border border-theme-border/40 group-hover:scale-110 transition-transform">
          {idx === 0 && (
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 stroke-palette-mocha dark:stroke-palette-slate stroke-2 fill-none" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          )}
          {idx === 1 && (
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 stroke-palette-mocha dark:stroke-palette-slate stroke-2 fill-none" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
            </svg>
          )}
          {idx === 2 && (
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 stroke-palette-mocha dark:stroke-palette-slate stroke-2 fill-none" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" />
              <path d="M3 9h18" />
              <path d="M3 15h18" />
              <path d="M9 3v18" />
            </svg>
          )}
          {idx === 3 && (
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 stroke-palette-mocha dark:stroke-palette-slate stroke-2 fill-none" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <line x1="2" x2="22" y1="12" y2="12" />
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
          )}
        </div>
        <h3 class="text-base font-bold text-theme-text mb-2">
          {feature.title}
        </h3>
        <p class="text-xs sm:text-sm text-theme-textMuted leading-relaxed">
          {feature.description}
        </p>
      </div>
    ))}
  </div>
</section>
